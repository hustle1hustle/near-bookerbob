# Copy to .env and fill in. Never commit .env. `make verify` needs none of these.

# NEAR network: testnet until a mainnet go is given.
NEAR_NETWORK=testnet
BAZAAR_ACCOUNT_ID=
NEAR_SIGNER_ACCOUNT_ID=
# Path to a near-cli credentials file, not the key itself.
NEAR_CREDENTIALS_FILE=

# USDC (Circle NEP-141). testnet id below; mainnet 17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1
USDC_CONTRACT_ID=3e2210e1184b45b64c8a434c0a7e7b23cc04ea7eb7a6c3c32520d03d4afcb8af

# NEAR AI Cloud (private inference, attestation). Used by the swarm "why" text only.
NEAR_AI_KEY=
NEAR_AI_MODEL=z-ai/glm-5.3-flash

# OutLayer (verification node). Payment Key only if the HTTPS path is used.
OUTLAYER_CONTRACT_ID=outlayer.testnet
OUTLAYER_PAYMENT_KEY=

# Chain Signatures MPC signer.
MPC_SIGNER_ID=v1.signer-prod.testnet

# NEAR Intents 1Click (mainnet only). Without a key the fee is +25 bps.
ONECLICK_JWT=
